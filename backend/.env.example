# ═══════════════════════════════════════════════════════
# SEHAT AI v2.0 — ENVIRONMENT TEMPLATE
# ═══════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values.

PORT=5000
NODE_ENV=development

# ─── DATABASE ──────────────────────────────────────────
# Get FREE at: mongodb.com/atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.xxx.mongodb.net/sehatai

# ─── JWT SECURITY ──────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRE=30d
JWT_REFRESH_EXPIRE=90d

# ─── AI APIS ──────────────────────────────────────────
# Get at: aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Get at: platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# Get at: platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# Get at: dashscope.aliyuncs.com
QWEN_API_KEY=your_qwen_api_key_here
QWEN_MODEL=qwen-turbo

# ─── AI FALLBACK ORDER ─────────────────────────────────
AI_FALLBACK_ORDER=gemini,openai,deepseek,qwen

# ─── EMAIL (OTP & Notifications) ──────────────────────
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
BACKUP_EMAIL=your_backup_email@gmail.com

# ─── PAYMENTS (Optional) ──────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

EASYPAISA_MERCHANT_ID=xxx
EASYPAISA_MERCHANT_KEY=xxx

JAZZCASH_MERCHANT_ID=xxx
JAZZCASH_PASSWORD=xxx

# ─── FILE STORAGE ──────────────────────────────────────
# Get FREE at: cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── ADMIN ─────────────────────────────────────────────
ADMIN_SECRET_KEY=your_admin_secret_here

# ─── SUBSCRIPTION LIMITS (Free Tier) ──────────────────
FREE_DAILY_MESSAGES=10
FREE_DAILY_IMAGE_SCANS=2
FREE_CONSULTATIONS_PER_DAY=3
FREE_MEDICINE_SEARCHES=5
